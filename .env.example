# ========================================================
# WhatsApp AD Assistant Bot - Environment Configuration
# ========================================================

# Groq API Key for AI Human Friend Conversations
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Telegram Admin Bridge Configuration
# Token of the bot used to control & monitor WhatsApp from Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Only this Telegram username will be accepted as admin
TELEGRAM_ADMIN_USERNAME=Daraz_Hacker
# Optional: Your numerical Telegram chat ID (will auto-learn on first /start)
TELEGRAM_ADMIN_ID=

# WhatsApp Connection Mode:
# Set to 'true' to get an 8-digit Pairing Code (no QR scanner needed)
# Set to 'false' to print a QR code in the VPS terminal
USE_PAIRING_CODE=true
# Your WhatsApp Phone Number with country code (e.g. 923001234567, no '+' sign)
# Required when USE_PAIRING_CODE=true
WHATSAPP_PHONE_NUMBER=

# Whitelist: Phone numbers allowed to chat with AD on WhatsApp
# Examples: 923001234567,923111234567
# Set to * to allow all contacts who message AD
ALLOWED_NUMBERS=*
